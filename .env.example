# Port d'écoute du serveur
PORT=5000

# Environnement (development / production)
NODE_ENV=development

# URL de connexion PostgreSQL (local ou Render / Supabase / Neon)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avs_db?schema=public"

# Clé secrète pour signer les JWT
JWT_SECRET="avs_secret_jwt_super_securise_2026_a_changer_en_production"
JWT_EXPIRES_IN="7d"

# URL du frontend pour autoriser les requêtes CORS
FRONTEND_URL="http://localhost:3000"

# Compte Administrateur initial (généré par prisma/seed.js)
ADMIN_EMAIL="admin@agrovetoservices.cg"
ADMIN_PASSWORD="Admin@Avs2026!"
