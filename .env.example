# Port d'écoute du serveur
PORT=5000

# Environnement (development / production)
NODE_ENV=development

# URL de connexion PostgreSQL (local ou Render / Supabase / Neon)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avs_db?schema=public"

# Clé secrète pour signer les JWT
JWT_SECRET="avs_secret_jwt_super_securise_2026_a_changer_en_production"
JWT_EXPIRES_IN="7d"

# URL du frontend pour autoriser les requêtes CORS
FRONTEND_URL="http://localhost:3000"

# Compte Administrateur initial (généré par prisma/seed.js)
ADMIN_EMAIL="admin@agrovetoservices.cg"
ADMIN_PASSWORD="Admin@Avs2026!"

# Emails transactionnels via Resend (mot de passe oublié).
# Sans RESEND_API_KEY : aucun email envoyé (le lien est loggé + renvoyé en dev uniquement).
RESEND_API_KEY=""
RESEND_FROM="Agro Véto Services <noreply@agrovetoservices.cg>"

# Stockage images Cloudinary (upload admin -> CDN).
# Sans ces clés : les images sont stockées en base64 dans la BDD.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
